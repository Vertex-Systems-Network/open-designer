{
  "name": "@open-designer/docs",
  "version": "0.1.0",
  "license": "MIT",
  "private": true,
  "type": "module",
  "imports": {
    "#docs/*": "./.vitepress/*"
  },
  "scripts": {
    "dev": "vitepress dev",
    "build": "OPENDESIGNER_DOCS_FAST_BUILD=1 NODE_OPTIONS=--max-old-space-size=8192 vitepress build --minify=false --buildConcurrency=8",
    "build:production": "bun run build:site && bun ../../tools/generate/landing-posters/src/generate.ts",
    "build:site": "OPENDESIGNER_LANDING_POSTERS=1 NODE_OPTIONS=--max-old-space-size=8192 vitepress build --minify=esbuild --buildConcurrency=8",
    "check": "bun ../../tools/checks/docs/src/check.ts",
    "preview": "vitepress preview"
  },
  "devDependencies": {
    "@iconify-json/simple-icons": "^1.2.98",
    "@open-designer/brand-tools": "workspace:*",
    "@open-designer/cli": "workspace:*",
    "@open-designer/demo-tools": "workspace:*",
    "@open-designer/feedback": "workspace:*",
    "@open-designer/landing-posters-tools": "workspace:*",
    "@open-designer/vite-config": "workspace:*",
    "@shikijs/vitepress-twoslash": "^4.4.3",
    "@tailwindcss/vite": "^4.3.3",
    "vitepress": "^2.0.0-alpha.19",
    "vitepress-plugin-llms": "1.12.2",
    "vue": "^3.5.43",
    "vue-component-meta": "^3.3.10"
  },
  "dependencies": {
    "@ai-sdk/vue": "^4.0.127",
    "@iconify/vue": "^5.0.1",
    "@open-designer/core": "workspace:*",
    "@open-designer/design-jsx": "workspace:*",
    "@open-designer/dom-css": "workspace:*",
    "@open-designer/scene-graph": "workspace:*",
    "@vueuse/core": "^14.4.0",
    "ai": "^7.0.127",
    "canvaskit-wasm": "^0.41.1",
    "dedent": "^1.7.2",
    "es-toolkit": "^1.52.0",
    "tinykeys": "^3.1.0",
    "valibot": "^1.5.0"
  }
}
