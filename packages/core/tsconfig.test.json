{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "rootDir": ".",
    "paths": {
      "#core/*": [
        "./src/*"
      ],
      "#core-tests/*": [
        "./tests/*"
      ],
      "@open-designer/core": [
        "./src/index.ts"
      ],
      "@open-designer/core/*": [
        "./src/*"
      ],
      "@open-pencil/core": [
        "./src/index.ts"
      ],
      "@open-pencil/core/*": [
        "./src/*"
      ],
      "@open-designer/scene-graph": [
        "../scene-graph/src/index.ts"
      ],
      "@open-designer/scene-graph/*": [
        "../scene-graph/src/*"
      ],
      "@open-designer/fig": [
        "../fig/src/index.ts"
      ],
      "@open-designer/fig/*": [
        "../fig/src/*"
      ],
      "@open-designer/design-jsx": [
        "../design-jsx/src/index.ts"
      ],
      "@open-designer/design-jsx/*": [
        "../design-jsx/src/*"
      ],
      "@open-designer/kiwi/*": [
        "../kiwi/src/*"
      ],
      "@open-designer/pen": [
        "../pen/src/index.ts"
      ],
      "@open-designer/pen/*": [
        "../pen/src/*"
      ],
      "@open-pencil/scene-graph": [
        "../scene-graph/src/index.ts"
      ],
      "@open-pencil/scene-graph/*": [
        "../scene-graph/src/*"
      ],
      "@open-pencil/fig": [
        "../fig/src/index.ts"
      ],
      "@open-pencil/fig/*": [
        "../fig/src/*"
      ],
      "@open-pencil/design-jsx": [
        "../design-jsx/src/index.ts"
      ],
      "@open-pencil/design-jsx/*": [
        "../design-jsx/src/*"
      ],
      "@open-pencil/kiwi/*": [
        "../kiwi/src/*"
      ],
      "@open-pencil/pen": [
        "../pen/src/index.ts"
      ],
      "@open-pencil/pen/*": [
        "../pen/src/*"
      ]
    }
  },
  "include": [
    "src",
    "tests"
  ]
}
