{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2023",
      "DOM"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowArbitraryExtensions": true,
    "types": [
      "node",
      "bun"
    ],
    "strict": true,
    "skipLibCheck": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "paths": {
      "#core/*": [
        "./src/*"
      ],
      "@open-designer/core": [
        "./src/index.ts"
      ],
      "@open-designer/core/*": [
        "./src/*"
      ],
      "@open-pencil/core": [
        "./src/index.ts"
      ],
      "@open-pencil/core/*": [
        "./src/*"
      ],
      "@open-pencil/scene-graph": [
        "../scene-graph/dist/index"
      ],
      "@open-pencil/scene-graph/*": [
        "../scene-graph/dist/*"
      ],
      "@open-pencil/fig": [
        "../fig/dist/index"
      ],
      "@open-pencil/fig/*": [
        "../fig/dist/*"
      ],
      "@open-pencil/design-jsx": [
        "../design-jsx/dist/index"
      ],
      "@open-pencil/design-jsx/*": [
        "../design-jsx/dist/*"
      ],
      "@open-pencil/kiwi/*": [
        "../kiwi/dist/*"
      ],
      "@open-pencil/pen": [
        "../pen/dist/index"
      ],
      "@open-pencil/pen/*": [
        "../pen/dist/*"
      ]
    }
  },
  "include": [
    "src"
  ]
}
