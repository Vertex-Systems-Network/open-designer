// Staging is served from the Cloudflare account's workers.dev subdomain.
{
  "name": "opendesigner-cloud-staging",
  "main": "worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "rules": [{ "type": "Text", "globs": ["**/*.toml"], "fallthrough": false }],
  "observability": { "enabled": true },
  // The site build comes from `--assets`.
  "assets": {
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": true
  },
  "workers_dev": true,
  "durable_objects": {
    "bindings": [{ "name": "RELAY", "class_name": "CollaborationRelayObject" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["CollaborationRelayObject"] }],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["*/5 * * * *"] },
  "secrets": {
    "required": [
      "TURSO_URL",
      "TURSO_AUTH_TOKEN",
      "BETTER_AUTH_SECRET",
      "GOOGLE_CLIENT_ID",
      "GOOGLE_CLIENT_SECRET",
      "S3_ACCESS_KEY_ID",
      "S3_SECRET_ACCESS_KEY"
    ]
  }
}
