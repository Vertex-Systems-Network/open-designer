# The Node runtime reads durable settings from this TOML file.
OPENDESIGNER_CLOUD_CONFIG=./opendesigner-cloud.toml
# The site build (`bun run build:cloud`): the editor, sign-in, account, and administration pages.
OPENDESIGNER_CLOUD_SITE_DIR=./dist-cloud
PORT=8787

# Required secrets. The conventional names below are the TOML defaults.
DATABASE_URL=postgresql://openpencil:opendesigner-development-password@localhost:54329/opendesigner
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
S3_ACCESS_KEY_ID=opendesigner
S3_SECRET_ACCESS_KEY=opendesigner-development-secret

# Optional secrets are required only when their corresponding TOML section is enabled.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# APPLE_PRIVATE_KEY=
# S3_SESSION_TOKEN=
# OPENDESIGNER_CLOUD_SMTP_USER=
# OPENDESIGNER_CLOUD_SMTP_PASSWORD=
# OPENDESIGNER_CLOUD_AI_SIGNING_KEY=
# OPENDESIGNER_CLOUD_SERVICE_TOKEN=

# The AI relay (`node dist-standalone/ai-relay.mjs`) reads its own TOML file and upstream key.
# OPENDESIGNER_AI_RELAY_CONFIG=./opendesigner-ai-relay.toml
# OPENDESIGNER_AI_RELAY_UPSTREAM_KEY=

# Compose infrastructure settings, not Cloud application configuration.
POSTGRES_PASSWORD=opendesigner-development-password
S3_REGION=us-east-1
S3_BUCKET=opendesigner

# After approving and signing in the first operator, grant the deployment admin role with:
# bun --filter @open-designer/cloud admin grant owner@example.com
