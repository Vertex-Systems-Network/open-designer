{
  "compilerOptions": {
    "target": "ES2022",
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "useUnknownInCatchVariables": true,
    "noFallthroughCasesInSwitch": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "declaration": true,
    "declarationMap": true,
    "outDir": "./dist",
    "rootDir": ".",
    "skipLibCheck": true,
    "types": ["bun"],
    "paths": {
      "#cloud/*": ["./src/*"],
      "#cloud-tests/*": ["./tests/*"],
      "@open-designer/cloud/contract": ["./src/contract/index.ts"],
      "@open-designer/cloud/client": ["./src/client/index.ts"],
      "@open-designer/cloud/email": ["./src/email/index.ts"],
      "@open-designer/cloud/runtime/node": ["./src/runtime/node/index.ts"],
      "@open-designer/cloud/server": ["./src/server/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "tests/**/*.ts", "deploy/**/*.ts"],
  "exclude": [
    "node_modules",
    "dist",
    "src/runtime/cloudflare",
    "deploy/cloudflare",
    "deploy/opendesigner",
    "deploy/generated"
  ]
}
