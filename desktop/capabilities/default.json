{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Capability for the main window",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:webview:allow-create-webview-window",
    "core:window:allow-set-focus",
    "core:window:allow-unminimize",
    "opener:default",
    "notification:default",
    "dialog:default",
    "dialog:allow-save",
    "dialog:allow-open",
    "updater:default",
    "process:default",
    "clipboard-manager:allow-read-text",
    "clipboard-manager:allow-write-html",
    "clipboard-manager:allow-write-text",
    "fs:deny-default",
    {
      "identifier": "fs:scope",
      "deny": [
        {
          "path": "$HOME/Library/LaunchAgents"
        },
        {
          "path": "$HOME/Library/LaunchAgents/**"
        },
        {
          "path": "$DATA/Microsoft/Windows/Start Menu/Programs/Startup"
        },
        {
          "path": "$DATA/Microsoft/Windows/Start Menu/Programs/Startup/**"
        },
        {
          "path": "$DOCUMENT/PowerShell"
        },
        {
          "path": "$DOCUMENT/PowerShell/**"
        },
        {
          "path": "$DOCUMENT/WindowsPowerShell"
        },
        {
          "path": "$DOCUMENT/WindowsPowerShell/**"
        },
        {
          "path": "/usr/local"
        },
        {
          "path": "/usr/local/**"
        },
        {
          "path": "/opt/homebrew"
        },
        {
          "path": "/opt/homebrew/**"
        },
        {
          "path": "$HOME/bin"
        },
        {
          "path": "$HOME/bin/**"
        },
        {
          "path": "$HOME/n"
        },
        {
          "path": "$HOME/n/**"
        },
        {
          "path": "$DATA/npm"
        },
        {
          "path": "$DATA/npm/**"
        },
        {
          "path": "$DATA/nvm"
        },
        {
          "path": "$DATA/nvm/**"
        },
        {
          "path": "$DATA/fnm"
        },
        {
          "path": "$DATA/fnm/**"
        },
        {
          "path": "$LOCALDATA/Volta"
        },
        {
          "path": "$LOCALDATA/Volta/**"
        },
        {
          "path": "$LOCALDATA/Programs"
        },
        {
          "path": "$LOCALDATA/Programs/**"
        },
        {
          "path": "$LOCALDATA/Microsoft/WindowsApps"
        },
        {
          "path": "$LOCALDATA/Microsoft/WindowsApps/**"
        },
        {
          "path": "$HOME/scoop"
        },
        {
          "path": "$HOME/scoop/**"
        }
      ]
    },
    {
      "identifier": "fs:allow-read-file",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-stat",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-lstat",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-open",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/Library/Application Support/OpenDesigner/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenDesigner/mcp.json"
        },
        {
          "path": "$RUNTIME/opendesigner/mcp.json"
        },
        {
          "path": "$HOME/.opendesigner/mcp.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        }
      ]
    },
    "fs:allow-fstat",
    "fs:allow-seek",
    "fs:allow-read",
    {
      "identifier": "fs:allow-read-text-file",
      "allow": [
        {
          "path": "$HOME/.pi/agent/settings.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenDesigner/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenDesigner/mcp.json"
        },
        {
          "path": "$RUNTIME/opendesigner/mcp.json"
        },
        {
          "path": "$HOME/.opendesigner/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-write-file",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/Library/Application Support/OpenDesigner/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenDesigner/mcp.json"
        },
        {
          "path": "$RUNTIME/opendesigner/mcp.json"
        },
        {
          "path": "$HOME/.opendesigner/mcp.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-exists",
      "allow": [
        {
          "path": "$HOME/.pi/agent/auth.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenDesigner/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenDesigner/mcp.json"
        },
        {
          "path": "$RUNTIME/opendesigner/mcp.json"
        },
        {
          "path": "$HOME/.opendesigner/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-mkdir",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    {
      "identifier": "fs:allow-remove",
      "allow": [
        {
          "path": "**"
        }
      ],
      "deny": [
        {
          "path": "$HOME/Library/Application Support/OpenDesigner/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenDesigner/mcp.json"
        },
        {
          "path": "$RUNTIME/opendesigner/mcp.json"
        },
        {
          "path": "$HOME/.opendesigner/mcp.json"
        },
        {
          "path": "$HOME/Library/Application Support/OpenPencil/mcp.json"
        },
        {
          "path": "$LOCALDATA/OpenPencil/mcp.json"
        },
        {
          "path": "$RUNTIME/openpencil/mcp.json"
        }
      ]
    },
    {
      "identifier": "fs:allow-watch",
      "allow": [
        {
          "path": "**"
        }
      ]
    },
    "fs:allow-unwatch",
    {
      "identifier": "shell:allow-spawn",
      "allow": [
        {
          "name": "claude-agent-acp",
          "cmd": "claude-agent-acp",
          "args": false
        },
        {
          "name": "claude-agent-acp-sign-in",
          "cmd": "claude-agent-acp",
          "args": [
            "--cli",
            "auth",
            "login",
            "--claudeai"
          ]
        },
        {
          "name": "codex-acp",
          "cmd": "codex-acp",
          "args": false
        },
        {
          "name": "gemini",
          "cmd": "gemini",
          "args": [
            "--acp"
          ]
        },
        {
          "name": "npm",
          "cmd": "npm",
          "args": [
            "install",
            "--global",
            {
              "validator": "^(@agentclientprotocol/(claude-agent-acp|codex-acp)|@open-designer/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?)$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "bun",
          "cmd": "bun",
          "args": [
            "add",
            "--global",
            {
              "validator": "^@open-designer/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "opendesigner-mcp-http",
          "cmd": "opendesigner-mcp-http",
          "args": false
        },
        {
          "name": "opendesigner-harness",
          "cmd": "opendesigner-harness",
          "args": false
        },
        {
          "name": "cmd-claude-agent-acp",
          "cmd": "cmd",
          "args": [
            "/c",
            "claude-agent-acp"
          ]
        },
        {
          "name": "cmd-claude-agent-acp-sign-in",
          "cmd": "cmd",
          "args": [
            "/c",
            "claude-agent-acp",
            "--cli",
            "auth",
            "login",
            "--claudeai"
          ]
        },
        {
          "name": "cmd-codex-acp",
          "cmd": "cmd",
          "args": [
            "/c",
            "codex-acp"
          ]
        },
        {
          "name": "cmd-gemini",
          "cmd": "cmd",
          "args": [
            "/c",
            "gemini",
            "--acp"
          ]
        },
        {
          "name": "cmd-npm",
          "cmd": "cmd",
          "args": [
            "/c",
            "npm",
            "install",
            "--global",
            {
              "validator": "^(@agentclientprotocol/(claude-agent-acp|codex-acp)|@open-designer/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?)$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "cmd-bun",
          "cmd": "cmd",
          "args": [
            "/c",
            "bun",
            "add",
            "--global",
            {
              "validator": "^@open-designer/(mcp|harness)@[0-9]+\\.[0-9]+\\.[0-9]+(-beta\\.[1-9][0-9]*)?$"
            },
            "--registry=https://registry.npmjs.org"
          ]
        },
        {
          "name": "cmd-opendesigner-mcp-http",
          "cmd": "cmd",
          "args": [
            "/c",
            "opendesigner-mcp-http"
          ]
        },
        {
          "name": "cmd-opendesigner-harness",
          "cmd": "cmd",
          "args": [
            "/c",
            "opendesigner-harness"
          ]
        }
      ]
    },
    "shell:allow-stdin-write",
    "shell:allow-kill"
  ]
}
