{
  "$schema": "https://raw.githubusercontent.com/devcontainers/spec/main/schemas/devContainer.base.schema.json",
  "name": "OpenDesigner",
  "build": {
    "dockerfile": "Dockerfile",
    "context": "."
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace/open-designer,type=bind,consistency=cached",
  "workspaceFolder": "/workspace/open-designer",
  "remoteUser": "bun",
  "updateRemoteUserUID": true,
  "mounts": [
    "source=open-designer-root-modules-${devcontainerId},target=/workspace/open-designer/node_modules,type=volume",
    "source=open-designer-scene-graph-modules-${devcontainerId},target=/workspace/open-designer/packages/scene-graph/node_modules,type=volume",
    "source=open-designer-pen-modules-${devcontainerId},target=/workspace/open-designer/packages/pen/node_modules,type=volume",
    "source=open-designer-kiwi-modules-${devcontainerId},target=/workspace/open-designer/packages/kiwi/node_modules,type=volume",
    "source=open-designer-fig-modules-${devcontainerId},target=/workspace/open-designer/packages/fig/node_modules,type=volume",
    "source=open-designer-core-modules-${devcontainerId},target=/workspace/open-designer/packages/core/node_modules,type=volume",
    "source=open-designer-dom-css-modules-${devcontainerId},target=/workspace/open-designer/packages/dom-css/node_modules,type=volume",
    "source=open-designer-design-jsx-modules-${devcontainerId},target=/workspace/open-designer/packages/design-jsx/node_modules,type=volume",
    "source=open-designer-emit-modules-${devcontainerId},target=/workspace/open-designer/packages/emit/node_modules,type=volume",
    "source=open-designer-vue-modules-${devcontainerId},target=/workspace/open-designer/packages/vue/node_modules,type=volume",
    "source=open-designer-cli-modules-${devcontainerId},target=/workspace/open-designer/packages/cli/node_modules,type=volume",
    "source=open-designer-mcp-modules-${devcontainerId},target=/workspace/open-designer/packages/mcp/node_modules,type=volume",
    "source=open-designer-docs-modules-${devcontainerId},target=/workspace/open-designer/packages/docs/node_modules,type=volume",
    "source=open-designer-docs-tool-modules-${devcontainerId},target=/workspace/open-designer/tools/docs/node_modules,type=volume"
  ],
  "postCreateCommand": "if git rev-parse --is-inside-work-tree >/dev/null 2>&1; then git lfs pull; fi && bun install --frozen-lockfile",
  "containerEnv": {
    "TAURI_DEV_HOST": "0.0.0.0"
  },
  "forwardPorts": [1420],
  "portsAttributes": {
    "1420": {
      "label": "OpenDesigner web editor",
      "onAutoForward": "notify"
    }
  }
}
